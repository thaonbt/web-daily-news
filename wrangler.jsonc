{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Phải trùng tên Worker đã tạo trong dashboard Cloudflare, nếu không Workers Builds sẽ báo lỗi.
  "name": "daily-news",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",

  // Chỉ thư mục site/ được công khai (main.py, workflow... không bị phục vụ).
  "assets": { "directory": "./site", "binding": "ASSETS" },

  // UTC: 22:17 = 05:17 ICT (phiên sáng), 04:17 = 11:17 ICT (phiên trưa).
  // Nếu đổi giờ ở đây, đổi cả SLOT_BY_CRON trong worker/index.js và cron dự phòng trong workflow.
  "triggers": { "crons": ["17 22 * * *", "17 4 * * *", "*/15 * * * *"] },

  "vars": {
    "GITHUB_REPO": "thaonbt/web-daily-news",
    "WORKFLOW_FILE": "update_news.yml",
    "GITHUB_REF": "main"
  },

  "observability": { "enabled": true }
}
